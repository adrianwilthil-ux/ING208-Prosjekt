<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Gazebo world anchor -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 1.6" rpy="0 0 0"/>
  </joint>

  <material name="blue">
    <color rgba="0.15 0.35 0.85 1.0"/>
  </material>
  <material name="orange">
    <color rgba="0.95 0.45 0.10 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.55 0.58 0.62 1.0"/>
  </material>

  <!-- Base -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0"
               iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><cylinder radius="0.12" length="0.15"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><cylinder radius="0.12" length="0.15"/></geometry>
    </collision>
  </link>

  <!-- DH joint 1: revolute about local Z -->
  <link name="joint1_rot">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0"
               iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.075"/>
      <geometry><cylinder radius="0.055" length="0.15"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.075"/>
      <geometry><cylinder radius="0.055" length="0.15"/></geometry>
    </collision>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="joint1_rot"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28318" upper="6.28318"
           effort="20" velocity="1.0"/>
  </joint>

  <!-- Fixed remainder of DH row 1: d=lb=0.15, alpha=-90 deg -->
  <link name="dh1_frame">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="dh1_fixed" type="fixed">
    <parent link="joint1_rot"/>
    <child link="dh1_frame"/>
    <origin xyz="0 0 0.15" rpy="-1.57079632679 0 0"/>
  </joint>

  <!-- DH joint 2 -->
  <link name="joint2_rot">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0"
               iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0.30 0 0"/>
      <geometry><box size="0.60 0.07 0.07"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.30 0 0"/>
      <geometry><box size="0.60 0.07 0.07"/></geometry>
    </collision>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="dh1_frame"/>
    <child link="joint2_rot"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28318" upper="6.28318"
           effort="20" velocity="1.0"/>
  </joint>

  <!-- Fixed remainder of DH row 2: a=L=0.60, alpha=0 -->
  <link name="dh2_frame">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="dh2_fixed" type="fixed">
    <parent link="joint2_rot"/>
    <child link="dh2_frame"/>
    <origin xyz="0.60 0 0" rpy="0 0 0"/>
  </joint>

  <!-- DH joint 3 -->
  <link name="joint3_rot">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.005" ixy="0" ixz="0"
               iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.06" length="0.10"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.06" length="0.10"/></geometry>
    </collision>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="dh2_frame"/>
    <child link="joint3_rot"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28318" upper="6.28318"
           effort="20" velocity="1.0"/>
  </joint>

  <!-- Fixed remainder of DH row 3: alpha=-90 deg -->
  <link name="dh3_frame">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="dh3_fixed" type="fixed">
    <parent link="joint3_rot"/>
    <child link="dh3_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
  </joint>

  <!-- DH joint 4 -->
  <link name="joint4_rot">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0"
               iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.30"/>
      <geometry><box size="0.07 0.07 0.60"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.30"/>
      <geometry><box size="0.07 0.07 0.60"/></geometry>
    </collision>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="dh3_frame"/>
    <child link="joint4_rot"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28318" upper="6.28318"
           effort="20" velocity="1.0"/>
  </joint>

  <!-- Fixed remainder of DH row 4: d=L=0.60, alpha=+90 deg -->
  <link name="dh4_frame">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="dh4_fixed" type="fixed">
    <parent link="joint4_rot"/>
    <child link="dh4_frame"/>
    <origin xyz="0 0 0.60" rpy="1.57079632679 0 0"/>
  </joint>

  <!-- DH joint 5 -->
  <link name="joint5_rot">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.005" ixy="0" ixz="0"
               iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.045" length="0.10"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.045" length="0.10"/></geometry>
    </collision>
  </link>

  <joint name="joint5" type="revolute">
    <parent link="dh4_frame"/>
    <child link="joint5_rot"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28318" upper="6.28318"
           effort="20" velocity="1.0"/>
  </joint>

  <!-- Fixed remainder of DH row 5: alpha=-90 deg -->
  <link name="dh5_frame">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="dh5_fixed" type="fixed">
    <parent link="joint5_rot"/>
    <child link="dh5_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
  </joint>

  <!-- Tool offset tl=0.35 m along final DH-frame Z -->
  <link name="tool_link">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.175"/>
      <geometry><cylinder radius="0.025" length="0.35"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.175"/>
      <geometry><cylinder radius="0.025" length="0.35"/></geometry>
    </collision>
  </link>

  <joint name="tool_fixed_joint" type="fixed">
    <parent link="dh5_frame"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Temporary geometry-check mode: disable gravity -->
  <gazebo reference="base_link"><gravity>false</gravity></gazebo>
  <gazebo reference="joint1_rot"><gravity>false</gravity></gazebo>
  <gazebo reference="dh1_frame"><gravity>false</gravity></gazebo>
  <gazebo reference="joint2_rot"><gravity>false</gravity></gazebo>
  <gazebo reference="dh2_frame"><gravity>false</gravity></gazebo>
  <gazebo reference="joint3_rot"><gravity>false</gravity></gazebo>
  <gazebo reference="dh3_frame"><gravity>false</gravity></gazebo>
  <gazebo reference="joint4_rot"><gravity>false</gravity></gazebo>
  <gazebo reference="dh4_frame"><gravity>false</gravity></gazebo>
  <gazebo reference="joint5_rot"><gravity>false</gravity></gazebo>
  <gazebo reference="dh5_frame"><gravity>false</gravity></gazebo>
  <gazebo reference="tool_link"><gravity>false</gravity></gazebo>

  <!-- ros2_control: position command, position/velocity state -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo ros2_control plugin -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/student/ros2_ws/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- ===== Ceiling plate (visual only, generated by make_ceiling_urdf.m) ===== -->
  <link name="ceiling_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="1.400 1.400 0.01"/>
      </geometry>
      <material name="ceiling_white">
        <color rgba="0.9 0.9 0.9 0.6"/>
      </material>
    </visual>
  </link>

  <joint name="base_to_ceiling" type="fixed">
    <parent link="base_link"/>
    <child link="ceiling_link"/>
    <origin xyz="-0.0340 0.0000 0.9580" rpy="0.00000 0.17453 0.00000"/>
  </joint>

  <gazebo reference="ceiling_link">
    <gravity>false</gravity>
  </gazebo>

</robot>
